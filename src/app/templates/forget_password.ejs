<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #f4f6f9;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #f4f6f9; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="background: #ffffff; border-radius: 12px; overflow: hidden"
          >
            <!-- Header -->
            <tr>
              <td align="center" style="background: #2563eb; padding: 30px">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px">
                  HealthCare
                </h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 40px">
                <h2 style="margin-top: 0; color: #222">Reset Your Password</h2>

                <p style="color: #555; font-size: 16px; line-height: 26px">
                  Dear <strong><%= name %></strong>,
                </p>

                <p style="color: #555; font-size: 16px; line-height: 26px">
                  We received a request to reset the password for your account.
                  Use the verification code below to proceed with resetting your
                  password.
                </p>

                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center">
                      <div
                        style="
                          display: inline-block;
                          background: #f3f4f6;
                          padding: 18px 40px;
                          border-radius: 8px;
                          font-size: 32px;
                          font-weight: bold;
                          letter-spacing: 8px;
                          color: #2563eb;
                          margin: 20px 0;
                          user-select: all;
                        "
                      >
                        <%= OTP %>
                      </div>
                    </td>
                  </tr>
                </table>

                <p style="color: #555; font-size: 16px; line-height: 26px">
                  This verification code will expire in
                  <strong> <%= expirationMinutes %> minutes</strong>.
                </p>

                <p style="color: #555; font-size: 16px; line-height: 26px">
                  For your security, do not share this code with anyone. Our
                  team will never ask you for your verification code.
                </p>

                <hr
                  style="
                    border: none;
                    border-top: 1px solid #e5e7eb;
                    margin: 30px 0;
                  "
                />

                <p style="color: #888; font-size: 14px; line-height: 22px">
                  If you did not request a password reset, you can safely ignore
                  this email. Your password will remain unchanged unless the
                  verification code is used.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="background: #f9fafb; padding: 25px">
                <p style="margin: 0; color: #777; font-size: 14px">
                  © <%= year %> HealthCare
                </p>

                <p style="margin-top: 8px; color: #999; font-size: 12px">
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
