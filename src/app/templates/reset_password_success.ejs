<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
</head>

<body style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;padding:40px 0;">
<tr>
<td align="center">

<table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;">

    <!-- Header -->
    <tr>
        <td align="center" style="background:#16a34a;padding:30px;">
            <h1 style="margin:0;color:#ffffff;font-size:28px;">
                HealthCare
            </h1>
        </td>
    </tr>

    <!-- Body -->
    <tr>
        <td style="padding:40px;">

            <h2 style="margin-top:0;color:#222;">
                Password Reset Successful
            </h2>

            <p style="color:#555;font-size:16px;line-height:26px;">
                Dear, <strong><%= name %></strong>
            </p>

            <p style="color:#555;font-size:16px;line-height:26px;">
                This email confirms that your account password has been successfully reset.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" style="margin:30px 0;">
                <tr>
                    <td align="center">
                        <div style="
                            display:inline-block;
                            background:#ecfdf5;
                            color:#16a34a;
                            border:1px solid #bbf7d0;
                            padding:16px 30px;
                            border-radius:8px;
                            font-size:18px;
                            font-weight:bold;">
                            ✓ Your password has been updated successfully.
                        </div>
                    </td>
                </tr>
            </table>

            <p style="color:#555;font-size:16px;line-height:26px;">
                You can now sign in using your new password.
            </p>

            <hr style="border:none;border-top:1px solid #e5e7eb;margin:30px 0;">

            <p style="color:#555;font-size:16px;line-height:26px;">
                <strong>Didn't make this change?</strong>
            </p>

            <p style="color:#555;font-size:16px;line-height:26px;">
                If you did not reset your password, please secure your account immediately by contacting our support team and changing your password as soon as possible.
            </p>

        </td>
    </tr>

    <!-- Footer -->
    <tr>
        <td align="center" style="background:#f9fafb;padding:25px;">

            <p style="margin:0;color:#777;font-size:14px;">
                © <%= year %> HealthCare
            </p>

            <p style="margin-top:8px;color:#999;font-size:12px;">
                This is an automated message from HealthCare. Please do not reply to this email.
            </p>

        </td>
    </tr>

</table>

</td>
</tr>
</table>

</body>
</html>